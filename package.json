{
  "name": "leesavontuur",
  "private": true,
  "version": "0.2.0-beta.4",
  "type": "module",
  "description": "LEESAVONTUUR - educatief leesspel (NL, 5-6 jaar). Offline-first, geen backend.",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "vite-node scripts/validate.ts",
    "check:dist": "vite-node scripts/check-dist.ts",
    "recordings": "vite-node scripts/recording-list.ts",
    "typecheck": "tsc --noEmit",
    "audio:catalog": "vite-node scripts/audio-catalog.ts",
    "audio:release": "vite-node scripts/audio-catalog.ts --release",
    "release:beta": "node scripts/package-release.mjs --beta",
    "release:stable": "node scripts/package-release.mjs",
    "audio:speech-plan": "vite-node scripts/speech-plan.ts"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@types/node": "^22.10.2",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^8.3.2",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fontsource/andika": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0"
  }
}
